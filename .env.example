NEXT_PUBLIC_SUPABASE_URL=your-value-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-value-here
SUPABASE_SERVICE_ROLE_KEY=your-value-here

# --- Pip, the AI task helper -------------------------------------------------
# Optional. With no key set, Pip answers from a built-in offline demo coach and
# says so in the chat. Set ANY ONE of the keys below to get real AI replies —
# they are tried in this order, so a free provider wins over OpenAI.
#
# Groq — free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter — has free ":free" models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI — requires prepaid credits: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides:
# AI_PROVIDER=groq            # pin one provider instead of auto-detecting
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=                # any other OpenAI-compatible endpoint
# AI_API_KEY=                 # key for AI_BASE_URL
